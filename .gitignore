# Secrets — never commit (see S-6)
.env
*.env
!.env.example
secrets/
*.key
*.pem
rcon.password
cloudflare-token*
cf-ddns.env

# AWS keys for the S3 offsite copy — the CSV AWS hands you on key creation
*accessKeys.csv
*credentials.csv
.aws/

# World data and server runtime — lives on the server, not in Git
world/
world_nether/
world_the_end/
backups/
*.jar
logs/
crash-reports/
cache/

# macOS
.DS_Store
stacks/*/data/

# Python bytecode from local syntax checks
__pycache__/
*.pyc

# Personal, deployment-specific material — never published. Anything in here is
# for this operator's copy only: cross-project notes, real hostnames, the AWS
# key CSV. The repository itself stays generic so it can be handed to anyone.
private/
